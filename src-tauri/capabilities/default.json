{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "fs:allow-mkdir",
    "fs:allow-app-write-recursive",
    "fs:allow-copy-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message"
  ]
}